#, python-brace-format
msgid ""
"Path {cls} with field_model={field_model} does not allow unnamed path "
"parameters args={args}"
msgstr ""
"مسیر {cls} با field_model={field_model} پارامترهای مسیر بدون‌نام args={args} "
"را مجاز نمی‌داند"

#, python-brace-format
msgid ""
"Trying to parse files with {parser_name} that does not support "
"SupportsFileParsing protocol"
msgstr ""
"تلاش برای تجزیه فایل‌ها با {parser_name} که از پروتکل SupportsFileParsing "
"پشتیبانی نمی‌کند"

#, python-brace-format
msgid "Method {method} is not allowed, allowed: {allowed}"
msgstr "متد {method} مجاز نیست، متدهای مجاز: {allowed}"

msgid "Not authenticated"
msgstr "احراز هویت نشده است"

msgid "Too many requests"
msgstr "تعداد درخواست‌ها بیش از حد مجاز است"

msgid "Internal server error"
msgstr "خطای داخلی سرور"

#, python-brace-format
msgid "CSRF Failed: {reason}"
msgstr "خطای CSRF: {reason}"

msgid ""
"HTTP requests with the 'application/x-www-form-urlencoded' content type must "
"be UTF-8 encoded."
msgstr ""
"درخواست‌های HTTP با نوع محتوای 'application/x-www-form-urlencoded' باید با "
"کدگذاری UTF-8 ارسال شوند."

#, python-brace-format
msgid ""
"Negotiated renderer {renderer_type} does not match returned content-type "
"{content_type}"
msgstr ""
"رندرر مذاکره‌شده {renderer_type} با نوع محتوای بازگشتی {content_type} مطابقت "
"ندارد"

#, python-brace-format
msgid ""
"Cannot serialize response body with accepted types {accepted_types}, "
"supported={supported}"
msgstr ""
"امکان سریالایز کردن بدنه پاسخ با انواع پذیرفته‌شده {accepted_types} وجود "
"ندارد، پشتیبانی‌شده={supported}"

#, python-brace-format
msgid ""
"Cannot parse request body with content type {content_type}, "
"expected={expected}"
msgstr ""
"امکان تجزیه بدنه درخواست با نوع محتوای {content_type} وجود ندارد، مورد "
"انتظار={expected}"

msgid "Invalid cursor"
msgstr "کرسر نامعتبر"

msgid "BlocklistedJWToken"
msgstr "توکن JWT مسدودشده"

msgid "BlocklistedJWTokens"
msgstr "توکن‌های JWT مسدودشده"

msgid "Name"
msgstr "نام"

msgid "Token hash"
msgstr "هش توکن"

msgid "Expires at"
msgstr "تاریخ انقضا"

msgid "Revoked at"
msgstr "تاریخ ابطال"

msgid "Last used at"
msgstr "آخرین زمان استفاده"

msgid "Created at"
msgstr "تاریخ ایجاد"

msgid "Updated at"
msgstr "تاریخ به‌روزرسانی"

msgid "Token"
msgstr "توکن"

msgid "Tokens"
msgstr "توکن‌ها"

#, python-brace-format
msgid "Value {value} of type {type} is not supported for {target_type}"
msgstr "مقدار {value} از نوع {type} برای {target_type} پشتیبانی نمی‌شود"
