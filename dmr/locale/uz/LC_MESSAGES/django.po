#, python-brace-format
msgid ""
"Path {cls} with field_model={field_model} does not allow unnamed path "
"parameters args={args}"
msgstr ""
"field_model={field_model} bilan {cls} yo'li, nomsiz yo'l parametrlariga "
"ruxsat bermaydi args={args}"

#, python-brace-format
msgid ""
"Trying to parse files with {parser_name} that does not support "
"SupportsFileParsing protocol"
msgstr ""
"SupportsFileParsing protokolini qo'llab-quvvatlamaydigan {parser_name} "
"parser'i yordamida fayllarni tahlil qilishga urinilmoqda"

#, python-brace-format
msgid "Method {method} is not allowed, allowed: {allowed}"
msgstr "{method} metodiga ruxsat berilmagan, ruxsat etilganlari: {allowed}"

msgid "Not authenticated"
msgstr "Autentifikatsiya qilinmagan"

msgid "Too many requests"
msgstr "So'rovlar soni juda ko'p"

msgid "Internal server error"
msgstr "Ichki server xatosi"

#, python-brace-format
msgid "CSRF Failed: {reason}"
msgstr "CSRF tekshiruvi muvaffaqiyatsiz tugadi: {reason}"

msgid ""
"HTTP requests with the 'application/x-www-form-urlencoded' content type must "
"be UTF-8 encoded."
msgstr ""
"'application/x-www-form-urlencoded' kontent turiga ega HTTP so'rovlar UTF-8 "
"orqali kodlangan bo'lishi kerak."

#, python-brace-format
msgid ""
"Negotiated renderer {renderer_type} does not match returned content-type "
"{content_type}"
msgstr ""
"Tanlangan renderchi {renderer_type} qaytarilgan {content_type} kontent "
"turiga mos kelmaydi "

#, python-brace-format
msgid ""
"Cannot serialize response body with accepted types {accepted_types}, "
"supported={supported}"
msgstr ""
"Javob matnini kelishilgan {accepted_types} turlari bilan serializatsiya "
"qilib bo'lmaydi, qo'llab-quvvatlanganlari: {supported}"

#, python-brace-format
msgid ""
"Cannot parse request body with content type {content_type}, "
"expected={expected}"
msgstr ""
"{content_type} kontent turiga ega so'rov matnini tahlil qilib bo'lmadi, "
"kutilgan edi: {expected}"

msgid "Invalid cursor"
msgstr "Noto'g'ri kursor"

msgid "BlocklistedJWToken"
msgstr "Bloklangan JWToken"

msgid "BlocklistedJWTokens"
msgstr "Bloklangan JWT tokenlar"

msgid "Name"
msgstr "Nomi"

msgid "Token hash"
msgstr "Token xesh"

msgid "Expires at"
msgstr "Muddati"

msgid "Revoked at"
msgstr "Bekor qilingan vaqti"

msgid "Last used at"
msgstr "Oxirgi marotaba foydalanilgan vaqti"

msgid "Created at"
msgstr "Yaratilgan vaqti"

msgid "Updated at"
msgstr "Yangilangan vaqti"

msgid "Token"
msgstr "Token"

msgid "Tokens"
msgstr "Tokenlar"

#, python-brace-format
msgid "Value {value} of type {type} is not supported for {target_type}"
msgstr ""
"{type} turidagi {value} qiymati, {target_type} uchun qo'llab-quvvatlanmaydi"
