#, python-brace-format
msgid ""
"Path {cls} with field_model={field_model} does not allow unnamed path "
"parameters args={args}"
msgstr ""
"Indlela {cls} ene-field_model={field_model} ayiyivumeli iiparameter "
"zendlela ezingenagama args={args}"

#, python-brace-format
msgid ""
"Trying to parse files with {parser_name} that does not support "
"SupportsFileParsing protocol"
msgstr ""
"Ukuzama ukuhlalutya iifayile nge-{parser_name} engayixhasiyo "
"iprotocol ye-SupportsFileParsing"

#, python-brace-format
msgid "Method {method} is not allowed, allowed: {allowed}"
msgstr "Indlela {method} ayivumelekanga, ezivumelekileyo: {allowed}"

msgid "Not authenticated"
msgstr "Akuqinisekisiwe ukuba ungubani"

msgid "Too many requests"
msgstr "Izicelo ezininzi kakhulu"

msgid "Internal server error"
msgstr "Impazamo yangaphakathi yeserver"

msgid ""
"HTTP requests with the 'application/x-www-form-urlencoded' content type must "
"be UTF-8 encoded."
msgstr ""
"Izicelo ze-HTTP ezinohlobo lwesiqulatho 'application/x-www-form-urlencoded' "
"kufuneka zifakwe ikhowudi nge-UTF-8."

#, python-brace-format
msgid ""
"Negotiated renderer {renderer_type} does not match returned content-type "
"{content_type}"
msgstr ""
"I-renderer evumelaniswe ngayo {renderer_type} ayihambelani nohlobo "
"lwesiqulatho olubuyisiweyo {content_type}"

#, python-brace-format
msgid ""
"Cannot serialize response body with accepted types {accepted_types}, "
"supported={supported}"
msgstr ""
"Ayikwazi ukwenza i-serialize yomzimba wempendulo ngezinto "
"ezamkelekileyo {accepted_types}, ezixhaswayo={supported}"

#, python-brace-format
msgid ""
"Cannot parse request body with content type {content_type}, "
"expected={expected}"
msgstr ""
"Ayikwazi ukuhlalutya umzimba wesicelo onohlobo lwesiqulatho "
"{content_type}, okulindelekileyo={expected}"

msgid "Invalid cursor"
msgstr "Ikhesa elingasebenziyo"

#, python-brace-format
msgid "CSRF Failed: {reason}"
msgstr "I-CSRF ayiphumelelanga: {reason}"

msgid "CSRF Failed."
msgstr "I-CSRF ayiphumelelanga."

msgid "BlocklistedJWToken"
msgstr "I-JWToken evalelwe ngaphandle"

msgid "BlocklistedJWTokens"
msgstr "Ii-JWToken ezivalelwe ngaphandle"

msgid "Name"
msgstr "Igama"

msgid "Token hash"
msgstr "I-hash yethokheni"

msgid "Expires at"
msgstr "Iphelelwa ngomhla"

msgid "Revoked at"
msgstr "Irhoxisiwe ngomhla"

msgid "Last used at"
msgstr "Isetyenziswe okokugqibela ngomhla"

msgid "Created at"
msgstr "Yenziwe ngomhla"

msgid "Updated at"
msgstr "Ihlaziywe ngomhla"

msgid "Token"
msgstr "Ithokheni"

msgid "Tokens"
msgstr "Amathokheni"

#, python-brace-format
msgid "Value {value} of type {type} is not supported for {target_type}"
msgstr "Ixabiso {value} lohlobo {type} alixhaswa kwi-{target_type}"