      "/_allauth/{client}/v1/auth/webauthn/signup": {
        "get": {
          "tags": [
            "Authentication: WebAuthn: Signup"
          ],
          "summary": "Get passkey credential request options",
          "description": "Returns the WebAuthn credential request options, that can be\nprocessed using `parseRequestOptionsFromJSON()` on the frontend.\n",
