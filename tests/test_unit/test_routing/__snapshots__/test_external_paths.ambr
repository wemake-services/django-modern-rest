                  "summary": "Reauthentication required\n",
                  "value": {
                    "status": 401,
                    "data": {
                      "user": {
                        "id": 123,
                        "display": "Magic Wizard",
                        "has_usable_password": true,
                        "email": "email@domain.org",
                        "username": "wizard"
                      },
                      "methods": [
                        {
                          "method": "password",
                          "at": 1711555057.065702,
                          "email": "email@domain.org"
                        },
                        {
                          "method": "mfa",
                          "at": 1711555060.9375854,
                          "id": 66,
                          "type": "totp"
                        }
                      ],
                      "flows": [
                        {
                          "id": "reauthenticate"
                        },
                        {
                          "id": "mfa_reauthenticate"
                        }
                      ]
                    },
                    "meta": {
                      "is_authenticated": true
                    }
