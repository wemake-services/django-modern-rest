# serializer version: 1
# name: test_external_paths_schema
  '''
  {
    "info": {
      "title": "Your Awesome Project",
      "version": "0.1.0"
    },
    "openapi": "3.1.0",
    "paths": {
      "/api/v1/async": {
        "get": {
          "tags": [
            "custom"
          ],
          "operationId": "getAsynccontrollerApiV1Async",
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "items": {
                      "type": "integer"
                    },
                    "type": "array"
                  }
                }
              }
            },
            "422": {
              "description": "Raised when returned response does not match the response schema",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorModel"
                  }
                }
              }
            },
            "406": {
              "description": "Raised when provided `Accept` header cannot be satisfied",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ErrorModel"
                  }
                }
              }
            }
          },
          "deprecated": false
        }
      },
      "/api/v1/_allauth/{client}/v1/config": {
        "get": {
          "tags": [
            "Configuration"
          ],
          "summary": "Get configuration",
          "description": "There are many configuration options that alter the functionality\nand behavior of django-allauth, some of which can also impact the\nfrontend. Therefore, relevant configuration options are exposed via\nthis endpoint. The data returned is not user/authentication\ndependent. Hence, it suffices to only fetch this data once at boot\ntime of your application.\n",
          "parameters": [
            {
              "deprecated": false
            }
          ],
          "responses": {
            "200": {}
          },
          "deprecated": false
        }
      },
      "/api/v1/_allauth/{client}/v1/auth/login": {
        "post": {
          "tags": [
            "Authentication: Account"
          ],
          "summary": "Login",
          "description": "Login using a username-password or email-password combination.\n",
          "parameters": [
            {
              "deprecated": false
            }
          ],
          "responses": {
            "200": {},
            "400": {
              "description": "An input error occurred.",
              "content": {
                "application/json": {
                  "schema": {},
                  "examples": {
                    "invalid_email": {},
                    "password_mismatch": {}
                  }
                }
              }
            },
            "401": {
              "description": "Not authenticated.\n",
              "content": {
                "application/json": {
                  "schema": {},
                  "examples": {
                    "pending_email": {},
                    "pending_2fa": {}
                  }
                }
              }
            },
            "409": {
              "description": "Conflict. For example, when logging in when a user is already logged in.\n",
              "content": {
                "application/json": {
                  "schema": {}
                }
              }
            }
          },
          "deprecated": false
        }
      }
    },
    "components": {
      "schemas": {
        "ErrorDetail": {
          "properties": {
            "msg": {
              "type": "string",
              "title": "Msg"
            },
            "type": {
              "type": "string",
              "title": "Type"
            },
            "loc": {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array",
              "title": "Loc"
            }
          },
          "type": "object",
          "required": [
            "msg"
          ],
          "title": "ErrorDetail",
          "description": "Base schema for error details description."
        },
        "ErrorModel": {
          "properties": {
            "detail": {
              "items": {
                "$ref": "#/components/schemas/ErrorDetail"
              },
              "type": "array",
              "title": "Detail"
            }
          },
          "type": "object",
          "required": [
            "detail"
          ],
          "title": "ErrorModel",
          "description": "Default error response schema.\n\nCan be customized.\nSee :ref:`customizing-error-messages` for more details."
        },
        "Session": {
          "properties": {
            "user_agent": {
              "type": "string",
              "example": "Mozilla Firefox"
            },
            "ip": {
              "type": "string",
              "example": "127.2.3.192"
            },
            "created_at": {},
            "is_current": {
              "type": "boolean"
            },
            "id": {
              "type": "integer",
              "example": 123
            },
            "last_seen_at": {}
          },
          "type": "object",
          "required": [
            "user_agent",
            "ip",
            "created_at",
            "is_current",
            "id"
          ]
        },
        "AccountConfiguration": {
          "properties": {
            "login_methods": {
              "items": {
                "type": "string",
                "enum": [
                  "email",
                  "username"
                ]
              },
              "type": "array"
            },
            "is_open_for_signup": {
              "type": "boolean"
            },
            "email_verification_by_code_enabled": {
              "type": "boolean"
            },
            "login_by_code_enabled": {
              "type": "boolean"
            },
            "password_reset_by_code_enabled": {
              "type": "boolean"
            }
          },
          "type": "object",
          "required": [
            "authentication_method",
            "email_verification_by_code_enabled",
            "is_open_for_signup",
            "login_by_code_enabled"
          ],
          "description": "Configuration of the Django `allauth.account` app.\n"
        },
        "AuthenticationResponse": {
          "properties": {
            "status": {
              "type": "integer",
              "enum": [
                401
              ]
            },
            "data": {
              "properties": {
                "flows": {
                  "items": {},
                  "type": "array"
                }
              },
              "type": "object",
              "required": [
                "flows"
              ]
            },
            "meta": {}
          },
          "type": "object",
          "required": [
            "status",
            "data",
            "meta"
          ],
          "description": "An authentication related response.\n"
        },
        "ForbiddenResponse": {
          "properties": {
            "status": {
              "type": "integer",
              "enum": [
                403
              ]
            }
          },
          "type": "object",
          "required": [
            "status"
          ]
        },
        "ConflictResponse": {
          "properties": {
            "status": {
              "type": "integer",
              "enum": [
                409
              ]
            }
          },
          "type": "object",
          "required": [
            "status"
          ]
        },
        "EndSessions": {
          "properties": {
            "sessions": {
              "items": {
                "type": "integer",
                "example": 123
              },
              "type": "array",
              "description": "The IDs of the sessions that are to be ended.\n"
            }
          },
          "type": "object",
          "required": [
            "sessions"
          ]
        },
        "PhoneNumber": {
          "properties": {
            "phone": {
              "type": "string",
              "example": "+314159265359"
            },
            "verified": {
              "type": "boolean"
            }
          },
          "type": "object",
          "required": [
            "phone",
            "verified"
          ],
          "description": "A phone number.\n"
        },
        "PhoneNumbersResponse": {
          "properties": {
            "status": {},
            "data": {
              "items": {},
              "type": "array"
            }
          },
          "type": "object",
          "required": [
            "status",
            "data"
          ]
        },
        "PhoneNumberChangeResponse": {
          "properties": {
            "status": {},
            "data": {
              "items": {},
              "type": "array"
            }
          },
          "type": "object",
          "required": [
            "status",
            "data"
          ],
          "example": {
            "status": 202,
            "data": [
              {
                "phone": "+314159265359",
                "verified": false
              }
            ]
          }
        },
        "ReauthenticationResponse": {
          "properties": {
            "status": {
              "type": "integer",
              "enum": [
                401
              ]
            },
            "data": {},
            "meta": {}
          },
          "type": "object",
          "required": [
            "status",
            "data",
            "meta"
          ],
          "description": "A response indicating reauthentication is required.\n"
        },
        "SessionGoneResponse": {
          "properties": {
            "status": {
              "type": "integer",
              "enum": [
                410
              ]
            },
            "data": {
              "type": "object"
            },
            "meta": {}
          },
          "type": "object",
          "required": [
            "status",
            "data",
            "meta"
          ],
          "description": "The session is expired or invalid.\n"
        },
        "BaseAuthenticationMeta": {
          "properties": {
            "session_token": {
              "type": "string",
              "description": "The session token (`app` clients only).\n",
              "example": "ufwcig0zen9skyd545jc0fkq813ghar2"
            },
            "access_token": {
              "type": "string",
              "description": "The access token (`app` clients only).\n",
              "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdW"
            }
          },
          "type": "object"
        },
        "AuthenticationMeta": {},
        "AuthenticatedMeta": {},
        "Flow": {
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "login",
                "login_by_code",
                "mfa_authenticate",
                "mfa_reauthenticate",
                "provider_redirect",
                "provider_signup",
                "provider_token",
                "reauthenticate",
                "signup",
                "verify_email",
                "verify_phone"
              ]
            },
            "provider": {},
            "is_pending": {
              "type": "boolean",
              "enum": [
                true
              ]
            },
            "types": {
              "items": {},
              "type": "array",
              "description": "Matches `settings.MFA_SUPPORTED_TYPES`."
            }
          },
          "type": "object",
          "required": [
            "id"
          ]
        },
        "Authenticated": {
          "properties": {
            "user": {},
            "methods": {
              "items": {},
              "type": "array",
              "description": "A list of methods used to authenticate.\n"
            }
          },
          "type": "object",
          "required": [
            "user",
            "methods"
          ]
        },
        "ReauthenticationRequired": {
          "properties": {
            "flows": {
              "items": {},
              "type": "array"
            },
            "user": {},
            "methods": {
              "items": {},
              "type": "array",
              "description": "A list of methods used to authenticate.\n"
            }
          },
          "type": "object",
          "required": [
            "flows",
            "user",
            "methods"
          ]
        },
        "AuthenticationMethod": {},
        "AuthenticatedResponse": {
          "properties": {
            "status": {},
            "data": {},
            "meta": {}
          },
          "type": "object",
          "required": [
            "status",
            "data",
            "meta"
          ]
        },
        "MFAAuthenticate": {
          "properties": {
            "code": {}
          },
          "type": "object",
          "required": [
            "code"
          ]
        },
        "MFATrust": {
          "properties": {
            "trust": {
              "type": "boolean"
            }
          },
          "type": "object",
          "required": [
            "trust"
          ]
        },
        "ConfirmLoginCode": {
          "properties": {
            "code": {}
          },
          "type": "object",
          "required": [
            "code"
          ]
        },
        "ClientID": {
          "type": "string",
          "description": "The client ID (in case of OAuth2 or OpenID Connect based providers)\n",
          "example": "123.apps.googleusercontent.com"
        },
        "ProviderToken": {
          "properties": {
            "provider": {},
            "process": {},
            "token": {
              "properties": {
                "client_id": {},
                "id_token": {
                  "type": "string",
                  "description": "The ID token.\n",
                  "example": "eyJhbGciOiJI"
                },
                "access_token": {
                  "type": "string",
                  "description": "The access token.\n",
                  "example": "36POk6yJV_adQs"
                }
              },
              "type": "object",
              "required": [
                "client_id"
              ],
              "description": "The token.\n"
            }
          },
          "type": "object",
          "required": [
            "provider",
            "process",
            "token"
          ]
        },
        "ProviderRedirect": {
          "properties": {
            "provider": {},
            "callback_url": {
              "type": "string",
              "description": "The URL to return to after the redirect flow is complete.\n\nNote that this is not to be mistaken with the callback URL that you\nconfigure over at the OAuth provider during the OAuth app/client\nsetup. The flow is as follows:\n\n  1. Your frontend redirects to the headless provider redirect\n     endpoint in a synchronous (non-XHR) manner, informing allauth\n     (by means of `callback_url`) where to redirect to after the\n     provider handshake is completed.\n\n  2. Headless will redirect to the (OAuth) identity provider to\n     initiate the handshake, passing along a different callback URL\n     to the provider: one that points to an allauth backend URL.\n     This is the URL that you need to have setup at your OAuth\n     app/client configuration. Note that this must be a backend URL\n     as providers can use POST requests to perform their callbacks,\n     which is something a frontend would not be able to handle.\n\n  3. After the authorization at the provider is completed, the\n     provider redirects to the *backend* allauth callback URL, which\n     will then redirect back to the *frontend* callback URL.\n\n  4. Your frontend is now expected to fetch the current session to\n     determine what the next course of action is. The user could be\n     authenticated at this point, or another flow is pending\n     (e.g. email verification, or, provider signup). In case of\n     errors a `?error=` is passed to the frontend callback URL.\n",
              "example": "https://app.project.org/account/provider/callback"
            },
            "process": {}
          },
          "type": "object",
          "required": [
            "provider",
            "process",
            "callback_url"
          ]
        },
        "RequestPassword": {
          "properties": {
            "email": {}
          },
          "type": "object",
          "required": [
            "email"
          ]
        },
        "RequestLoginCode": {
          "type": "object"
        },
        "Reauthenticate": {
          "properties": {
            "password": {}
          },
          "type": "object",
          "required": [
            "password"
          ]
        },
        "ProviderSignup": {},
        "PasskeySignup": {},
        "BaseSignup": {
          "properties": {
            "email": {},
            "phone": {},
            "username": {}
          },
          "type": "object"
        },
        "Signup": {},
        "Username": {
          "type": "string",
          "description": "The username.\n",
          "example": "wizard"
        },
        "Email": {
          "type": "string",
          "description": "The email address.\n",
          "example": "email@domain.org"
        },
        "Phone": {
          "type": "string",
          "description": "The phone number.\n",
          "example": "+314159265359"
        },
        "AccessToken": {
          "type": "string",
          "description": "The access token.\n",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdW"
        },
        "RefreshToken": {
          "type": "string",
          "description": "The refresh token.\n",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.QV30"
        },
        "Login": {},
        "StatusOK": {
          "type": "integer",
          "enum": [
            200
          ]
        },
        "StatusAccepted": {
          "type": "integer",
          "enum": [
            202
          ]
        },
        "AuthenticatorID": {
          "type": "integer",
          "description": "Authenticator ID.\n",
          "example": 123
        },
        "SocialAccountConfiguration": {
          "properties": {
            "providers": {}
          },
          "type": "object",
          "required": [
            "providers"
          ],
          "description": "Configuration of the Django `allauth.socialaccount` app.\n"
        },
        "MFAConfiguration": {
          "properties": {
            "supported_types": {
              "items": {},
              "type": "array",
              "description": "Matches `settings.MFA_SUPPORTED_TYPES`.\n"
            }
          },
          "type": "object",
          "required": [
            "supported_types"
          ],
          "description": "Configuration of the Django `allauth.mfa` app.\n"
        },
        "UserSessionsConfiguration": {
          "properties": {
            "track_activity": {
              "type": "boolean",
              "description": "Matches `settings.USERSESSIONS_TRACK_ACTIVITY`.\n"
            }
          },
          "type": "object",
          "required": [
            "track_activity"
          ],
          "description": "Configuration of the Django `allauth.usersessions` app.\n"
        },
        "ConfigurationResponse": {
          "properties": {
            "data": {
              "properties": {
                "account": {},
                "socialaccount": {},
                "mfa": {},
                "usersessions": {}
              },
              "type": "object",
              "required": [
                "account"
              ]
            },
            "status": {}
          },
          "type": "object",
          "required": [
            "status",
            "data"
          ],
          "example": {
            "status": 200,
            "data": {
              "account": {
                "authentication_method": "email"
              },
              "socialaccount": {
                "providers": [
                  {
                    "id": "google",
                    "name": "Google",
                    "flows": [
                      "provider_redirect",
                      "provider_token"
                    ],
                    "client_id": "123.apps.googleusercontent.com",
                    "openid_configuration_url": "https://accounts.google.com/.well-known/openid-configuration"
                  }
                ]
              },
              "mfa": {
                "supported_types": [
                  "recovery_codes",
                  "totp"
                ]
              },
              "usersessions": {
                "track_activity": false
              }
            }
          }
        },
        "ResetPassword": {
          "properties": {
            "key": {
              "type": "string",
              "description": "The password reset key",
              "example": "2f-c4nqd4-e07d9bc694f9f28cd4fe92569d495333"
            },
            "password": {}
          },
          "type": "object",
          "required": [
            "key",
            "password"
          ]
        },
        "VerifyEmail": {
          "properties": {
            "key": {
              "type": "string",
              "description": "The email verification key",
              "example": "2f-c4nqd4-e07d9bc694f9f28cd4fe92569d495333"
            }
          },
          "type": "object",
          "required": [
            "key"
          ]
        },
        "VerifyPhone": {
          "properties": {
            "code": {
              "type": "string",
              "description": "The phone verification code",
              "example": "4S3H82"
            }
          },
          "type": "object",
          "required": [
            "code"
          ]
        },
        "OptionalTimestamp": {},
        "Timestamp": {
          "type": "number",
          "description": "An epoch based timestamp (trivial to parse using: `new Date(value)*1000`)\n",
          "example": 1711555057.065702
        },
        "AuthenticatorCode": {
          "type": "string",
          "description": "An authenticator code.\n",
          "example": "314159"
        },
        "Code": {
          "type": "string",
          "description": "An one-time code.\n",
          "example": "NQ3TM5"
        },
        "AuthenticatorType": {
          "type": "string",
          "enum": [
            "recovery_codes",
            "totp",
            "webauthn"
          ],
          "description": "The type of authenticator.\n"
        },
        "Password": {
          "type": "string",
          "description": "The password.\n",
          "example": "Alohomora!"
        },
        "ErrorResponse": {
          "properties": {
            "status": {
              "type": "integer",
              "enum": [
                400
              ],
              "example": 400
            },
            "errors": {
              "items": {
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "An error code.\n",
                    "example": "invalid"
                  },
                  "param": {
                    "type": "string",
                    "description": "The name of the input parameter that was incorrect.\n",
                    "example": "email"
                  },
                  "message": {
                    "type": "string",
                    "description": "A human readable error message.\n",
                    "example": "Enter a valid email address."
                  }
                },
                "type": "object",
                "required": [
                  "code",
                  "message"
                ]
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "Process": {
          "type": "string",
          "enum": [
            "login",
            "connect"
          ],
          "description": "The process to be executed when the user successfully\nauthenticates. When set to `login`, the user will be logged into the\naccount to which the provider account is connected, or if no such\naccount exists, a signup will occur. If set to `connect`, the provider\naccount will be connected to the list of provider accounts for the\ncurrently authenticated user.\n",
          "example": "login"
        },
        "ProviderID": {
          "type": "string",
          "description": "The provider ID.\n",
          "example": "google"
        },
        "ProviderAccountID": {
          "type": "string",
          "description": "The provider specific account ID.\n",
          "example": "goo12345"
        },
        "User": {
          "properties": {
            "id": {
              "description": "The user ID.\n"
            },
            "display": {
              "type": "string",
              "description": "The display name for the user.\n",
              "example": "Magic Wizard"
            },
            "has_usable_password": {
              "type": "boolean",
              "description": "Whether or not the account has a password set.\n",
              "example": true
            },
            "email": {},
            "username": {}
          },
          "type": "object"
        },
        "EmailAddress": {
          "properties": {
            "email": {},
            "primary": {
              "type": "boolean",
              "example": true
            },
            "verified": {
              "type": "boolean",
              "example": false
            }
          },
          "type": "object",
          "required": [
            "email",
            "primary",
            "verified"
          ]
        },
        "BaseAuthenticator": {
          "properties": {
            "last_used_at": {},
            "created_at": {}
          },
          "type": "object",
          "required": [
            "created_at",
            "last_used_at"
          ]
        },
        "TOTPAuthenticator": {},
        "WebAuthnAuthenticator": {},
        "RecoveryCodesAuthenticator": {},
        "SensitiveRecoveryCodesAuthenticator": {},
        "AuthenticatorList": {
          "items": {},
          "type": "array"
        },
        "ProviderList": {
          "items": {},
          "type": "array"
        },
        "Provider": {
          "properties": {
            "id": {
              "type": "string",
              "description": "The provider ID.\n",
              "example": "google"
            },
            "name": {
              "type": "string",
              "description": "The name of the provider.\n",
              "example": "Google"
            },
            "client_id": {
              "type": "string",
              "description": "The client ID (in case of OAuth2 or OpenID Connect based providers)\n",
              "example": "123.apps.googleusercontent.com"
            },
            "openid_configuration_url": {
              "type": "string",
              "description": "The OIDC discovery or well-known URL (in case of OAuth2 or OpenID Connect based providers)\n",
              "example": "https://accounts.google.com/.well-known/openid-configuration"
            },
            "flows": {
              "items": {
                "type": "string",
                "enum": [
                  "provider_redirect",
                  "provider_token"
                ]
              },
              "type": "array",
              "description": "The authentication flows the provider integration supports.\n"
            }
          },
          "type": "object",
          "required": [
            "id",
            "name",
            "flows"
          ]
        },
        "ProviderAccount": {
          "properties": {
            "uid": {},
            "display": {
              "type": "string",
